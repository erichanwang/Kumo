    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "kuromoji": "^0.1.2",
    "path-browserify": "^1.0.1"
