{
  "name": "kumo",
  "private": true,
  "version": "0.0.1a",
  "type": "module",
  "description": "Read Japanese anywhere. Learn as you go.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
